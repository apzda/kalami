            <artifactId>hajimi-storage-core</artifactId>
        </dependency>
        <!-- 通过openfeign提供服务时本工程只能像下边这样引入依赖 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.apzda.hajimi.ucenter.infrastructure.mybatis.mapper.RolePrivilegeMapper">
    <delete id="revokeByPrivilegeId">
        DELETE
        FROM ucenter_role_privilege
        WHERE privilege_id = #{privilegeId}
    </delete>
    <delete id="deleteByRoleIdAndPrivilegeId">
        DELETE
        FROM ucenter_role_privilege
        WHERE role_id = #{roleId}
          AND privilege_id = #{privilegeId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE
        FROM ucenter_role_privilege
        WHERE role_id = #{roleId}
    </delete>

    <select id="listPrivilegesByRoleIds"
            resultType="com.apzda.hajimi.ucenter.domain.entity.RbacPrivilegeEntity">
        SELECT P.* FROM ucenter_role_privilege RP LEFT JOIN ucenter_rbac_privilege P ON P.id = RP.privilege_id
        WHERE RP.tenant_id = #{tenantId} AND P.deleted = 0
        <if test="roleIds!=null and roleIds.size() > 0">
            AND RP.role_id IN
            <foreach collection="roleIds" item="rid" open="(" close=")" separator=",">#{rid}</foreach>
        </if>
    </select>
    <select id="existsByRoleIdAndPrivilegeId" resultType="java.lang.Boolean">
        SELECT COUNT(*)
        FROM ucenter_role_privilege
        WHERE role_id = #{roleId}
          AND privilege_id = #{privilegeId}
    </select>
</mapper>
